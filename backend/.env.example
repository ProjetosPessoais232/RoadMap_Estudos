# Copie para backend/.env e preencha os valores.
# O Postgres do docker-compose expõe a porta 5434 (5432 fica livre para um PostgreSQL local).

GEMINI_API_KEY=sua_chave_aqui

# Opcional — padrões em application.yml já apontam para o Docker:
# DATABASE_URL=jdbc:postgresql://localhost:5434/roadmap
# DATABASE_USER=roadmap
# DATABASE_PASSWORD=roadmap

# Se preferir o PostgreSQL instalado no Windows (porta 5432), use:
# DATABASE_URL=jdbc:postgresql://localhost:5432/roadmap
# DATABASE_USER=roadmap
# DATABASE_PASSWORD=roadmap
